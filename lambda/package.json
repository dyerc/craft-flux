{
  "name": "fluxlambda",
  "version": "1.0.0",
  "description": "",
  "main": "request.ts",
  "scripts": {
    "clean": "rm -rf ../src/lambda/request/*.js && rm -rf ../src/lambda/response/*.js",
    "prebuild": "yarn clean",
    "build": "yarn build:request && yarn build:response",
    "build:request": "esbuild request.ts --bundle --minify --sourcemap --platform=node --external:sharp --target=es2020 --outfile=../src/lambda/request/index.js",
    "build:response": "esbuild response.ts --bundle --minify --sourcemap --platform=node --external:sharp --target=es2020 --outfile=../src/lambda/response/index.js",
    "test": "jest",
    "lint": "eslint ."
  },
  "author": "Chris Dyer",
  "private": true,
  "devDependencies": {
    "@types/aws-lambda": "^8.10.159",
    "@types/jest": "^30.0.0",
    "@types/sharp": "^0.31.1",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-jest": "^4.1.0",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.1",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.937.0",
    "axios": "^1.13.2",
    "sharp": "^0.34.5"
  }
}
